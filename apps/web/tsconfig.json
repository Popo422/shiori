{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": [
      "vite/client",
      "vite-plugin-pwa/client"
    ],
    "allowJs": true,
    "declaration": false
  },
  "include": [
    "src",
    "vite.config.ts"
  ],
  "exclude": [
    "vendor",
    "dist"
  ]
}
