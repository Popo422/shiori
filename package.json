{
  "name": "shiori",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "deploy": "turbo run deploy",
    "db:generate": "npm run generate -w @shiori/db",
    "db:migrate": "wrangler d1 migrations apply shiori --remote --cwd apps/api",
    "db:migrate:local": "wrangler d1 migrations apply shiori --local --cwd apps/api",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  }
}
